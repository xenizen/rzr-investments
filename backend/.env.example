# Copy to backend/.env and fill in. backend/.env is gitignored.
# Deployment sets these through the WSGI host instead.

# Alpaca PAPER account (used for market data + read-only account context).
# Do not put live-trading keys here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# SEC EDGAR requires a real "name email" identity string on every request.
EDGAR_IDENTITY=enochmgmt.com you@example.com

# PostgreSQL connection for the Form 4 transaction store (epic SCRUM-42).
# libpq URL. The value below matches the local-setup steps in the README;
# production (InMotion cPanel Postgres, account-prefixed names) is set in
# backend/.env on the server -- see docs/production-database.md.
DATABASE_URL=postgresql://rzr_invest:rzr_invest@localhost:5432/rzr_invest
