# Copy to backend/.env and fill in. backend/.env is gitignored.
# Deployment sets these through the WSGI host instead.

# Alpaca PAPER account (used for market data + read-only account context).
# Do not put live-trading keys here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# SEC EDGAR requires a real "name email" identity string on every request.
EDGAR_IDENTITY=enochmgmt.com you@example.com
